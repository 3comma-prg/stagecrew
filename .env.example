# Googleスプレッドシート ID（作業用／移行元。アプリ本体のDBではない）
# URL の /d/ と /edit の間。設定画面の「Googleスプレッドシート連携」が空のときの予備です
GOOGLE_SPREADSHEET_ID=

# SQLite ファイルパス（省略時は data/stagecrew.sqlite）
# Docker では /app/data/stagecrew.sqlite を推奨（./data ボリュームに永続化）
# DATABASE_PATH=data/stagecrew.sqlite

# サービスアカウント JSON をそのまま1行で入れるか、JSONファイルのパスを指定する
GOOGLE_SERVICE_ACCOUNT_JSON=

# またはメールと秘密鍵を分けて指定する（JSON を使う場合は不要）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 請求書PDF出力後のGmail下書き作成には、Google Cloud で Gmail API を有効にし
# ドメイン全体の委任（gmail.compose と gmail.settings.basic）が必要です
# 送信元メールアドレスはアプリの設定画面で保存します

# 設定画面の URL / ID の保存先（省略時は data/app-settings.json）
# 初期値は defaults/app-settings.json からコピーします
# SETTINGS_FILE=data/app-settings.json
# SETTINGS_DEFAULTS_FILE=defaults/app-settings.json

# Docker / 本番起動時の待ち受け（省略時は 5173）
# PORT=5173
# HOST=0.0.0.0

# バックアップ: コンテナ停止後に data/stagecrew.sqlite をコピーしてください
# （WAL 使用時は stagecrew.sqlite-wal / stagecrew.sqlite-shm もあわせて）
